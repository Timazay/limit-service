{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@aeondave/opencode-dotenv@latest"],
  "mcp": {
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "PG_USER",
        "-e",
        "PG_PASSWORD",
        "mochoa/mcp-postgres",
        "${MCP_PG_URL}"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "timeout": 60000
    }
  }
}